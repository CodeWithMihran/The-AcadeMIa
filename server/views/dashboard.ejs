<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | RIT AcadeMIA</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }
        .notion-card {
            background: white;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }
        .notion-card:hover {
            border-color: #d1d5db;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            transform: translateY(-4px);
        }
        .step-line::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: 0;
            width: 1px;
            background: #e5e7eb;
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-user") %>

    <div class="max-w-7xl mx-auto px-6 pt-32 pb-20">

        <% if (currentUser && currentUser.branch === "Not Set") { %>
            <div class="bg-blue-50 border-l-4 border-blue-500 p-5 mb-10 rounded-r-2xl shadow-sm flex items-center gap-4" data-aos="fade-down">
                <div class="h-10 w-10 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
                    <i class="ri-user-settings-line text-xl"></i>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-blue-900">Complete your Academic Profile</h4>
                    <p class="text-xs text-blue-700 mt-0.5">
                        Please <a href="/profile" class="underline font-black hover:text-blue-900 transition-colors">set your Branch and Semester</a> to see the correct subjects for your course.
                    </p>
                </div>
            </div>
        <% } %>

        <div class="mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-6" data-aos="fade-up">
            <div>
                <h1 class="text-5xl font-black tracking-tighter text-[#1a1a1a] mb-3 italic">
                    Dashboard <span class="text-gray-300 font-light not-italic">/</span> <%= user.name %>
                </h1>
                <p class="text-gray-500 font-medium">
                    Current Focus: <span class="text-[#1a1a1a]"><%= user.branch %> &bull; Semester <%= user.semester %></span>
                </p>
            </div>
            <div class="bg-black text-white px-6 py-3 rounded-2xl shadow-lg shadow-gray-200">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] opacity-60">Status</p>
                <p class="text-sm font-bold flex items-center gap-2">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span> Academic Session Active
                </p>
            </div>
        </div>

        <div class="flex items-center gap-4 mb-8" data-aos="fade-up">
            <h2 class="text-xs font-black tracking-[0.4em] text-gray-400 uppercase">Your Curriculum Vault</h2>
            <div class="h-[1px] flex-grow bg-gray-100"></div>
        </div>

        <% if (subjects.length === 0) { %>
            <div class="notion-card p-20 rounded-[2rem] text-center border-dashed border-2">
                <p class="text-gray-400 font-medium italic">No subjects syncronized for your profile yet.</p>
            </div>
        <% } else { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% subjects.forEach((subject, index) => { %>
                    <div class="notion-card rounded-[2rem] p-8 flex flex-col justify-between group" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                        <div>
                            <div class="flex justify-between items-start mb-8">
                                <div class="h-14 w-14 bg-gray-50 rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
                                    <%= ['📚', '💻', '⚙️', '🧪', '🔢'][index % 5] %>
                                </div>
                                <span class="text-[10px] font-black text-gray-400 border border-gray-100 px-3 py-1.5 rounded-xl uppercase">
                                    Units: <%= subject.units.length %>
                                </span>
                            </div>
                            <h3 class="text-2xl font-black text-[#1a1a1a] mb-2 leading-tight tracking-tighter">
                                <%= subject.name %>
                            </h3>
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-10">Academic Core</p>
                        </div>

                        <div class="flex flex-col gap-3">
                            <a href="/subjects/<%= subject._id %>" class="bg-[#0a0a0a] text-white py-3.5 rounded-2xl text-xs font-black uppercase tracking-widest text-center hover:bg-black transition-all shadow-xl shadow-gray-200 active:scale-95">
                                Enter Vault
                            </a>
                            <a href="/progress/<%= subject._id %>" class="border border-gray-200 text-gray-600 py-3.5 rounded-2xl text-xs font-black uppercase tracking-widest text-center hover:bg-gray-50 transition-all">
                                Progress Tracker
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <div class="mt-32 grid lg:grid-cols-2 gap-16 items-center">
            <div data-aos="fade-right">
                <h2 class="text-xs font-black tracking-[0.4em] text-blue-500 uppercase mb-4">The AcadeMIA Methodology</h2>
                <h3 class="text-4xl font-black text-[#1a1a1a] mb-6 tracking-tighter">How to use this platform to ace your exams.</h3>
                <p class="text-gray-500 mb-8 leading-relaxed">
                    We don't just provide links; we provide structure. Follow this 4-step workflow to ensure you're fully prepared for your sessional and university exams.
                </p>
                
                <div class="space-y-8 relative">
                    <div class="flex gap-6 items-start relative z-10">
                        <div class="w-10 h-10 bg-white border border-gray-200 rounded-full flex items-center justify-center font-black shrink-0 shadow-sm">1</div>
                        <div>
                            <h4 class="font-bold text-[#1a1a1a]">Explore the Vault</h4>
                            <p class="text-sm text-gray-500">Pick a subject and browse through organized Unit-wise materials.</p>
                        </div>
                    </div>
                    <div class="flex gap-6 items-start relative z-10">
                        <div class="w-10 h-10 bg-white border border-gray-200 rounded-full flex items-center justify-center font-black shrink-0 shadow-sm">2</div>
                        <div>
                            <h4 class="font-bold text-[#1a1a1a]">Master via Video</h4>
                            <p class="text-sm text-gray-500">Watch curated YouTube lectures that map directly to your syllabus.</p>
                        </div>
                    </div>
                    <div class="flex gap-6 items-start relative z-10">
                        <div class="w-10 h-10 bg-white border border-gray-200 rounded-full flex items-center justify-center font-black shrink-0 shadow-sm">3</div>
                        <div>
                            <h4 class="font-bold text-[#1a1a1a]">Solve PYQs</h4>
                            <p class="text-sm text-gray-500">Access Previous Year Questions to understand exam patterns early.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-[#0a0a0a] rounded-[2.5rem] p-10 text-white relative overflow-hidden" data-aos="fade-left">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 blur-[100px] rounded-full"></div>
                <h4 class="text-2xl font-black mb-6 italic">Platform Features</h4>
                <ul class="space-y-6">
                    <li class="flex items-center gap-4">
                        <span class="p-2 bg-white/10 rounded-lg">📑</span>
                        <div>
                            <p class="font-bold text-sm">Centralized PDFs</p>
                            <p class="text-xs text-gray-400">Handwritten and official notes in one place.</p>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="p-2 bg-white/10 rounded-lg">🎥</span>
                        <div>
                            <p class="font-bold text-sm">Timestamped Lectures</p>
                            <p class="text-xs text-gray-400">Jump straight to the topic you need.</p>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="p-2 bg-white/10 rounded-lg">📊</span>
                        <div>
                            <p class="font-bold text-sm">Visual Tracking</p>
                            <p class="text-xs text-gray-400">See your syllabus coverage in real-time.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <%- include("partials/footer-user") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>

</body>
</html>