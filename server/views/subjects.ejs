<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum Vault | RIT AcadeMIA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }
        .subject-card {
            background: white;
            border: 1px solid #e5e7eb;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .subject-card:hover {
            border-color: #1a1a1a;
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-user") %>

    <div class="max-w-7xl mx-auto px-6 pt-32 pb-20">

        <div class="mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-8" data-aos="fade-up">
            <div>
                <h1 class="text-5xl font-black tracking-tighter text-[#1a1a1a] mb-4 italic">
                    The <span class="text-gray-300 font-light not-italic">Curriculum</span> Vault
                </h1>
                <div class="flex items-center gap-4">
                    <span class="bg-black/5 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest text-gray-500">
                        <%= user.branch %>
                    </span>
                    <span class="h-1 w-1 bg-gray-300 rounded-full"></span>
                    <span class="text-xs font-bold text-gray-400">Semester <%= user.semester %></span>
                </div>
            </div>
            <div class="bg-black text-white px-8 py-4 rounded-3xl shadow-2xl shadow-gray-200">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] opacity-50 mb-1">Authenticated Access</p>
                <p class="text-xl font-black tracking-tighter"><%= subjects.length %> Active Modules</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20" data-aos="fade-up" data-aos-delay="100">
            <div class="stat-card p-8 rounded-[2rem]">
                <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Study Load</p>
                <p class="text-2xl font-black italic tracking-tighter text-[#1a1a1a]">Full Capacity</p>
            </div>
            
            <div class="stat-card p-8 rounded-[2rem] bg-blue-50/50 border-blue-100/50">
                <p class="text-[9px] font-black text-blue-400 uppercase tracking-widest mb-1">Resources</p>
                <p class="text-2xl font-black italic tracking-tighter text-blue-600">Cloud Synced</p>
            </div>

            <div class="stat-card p-8 rounded-[2rem] bg-black text-white border-none relative overflow-hidden">
                <div class="absolute top-0 right-0 w-16 h-16 bg-blue-500/20 blur-2xl rounded-full"></div>
                
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">System Status</p>
                <div class="flex items-center gap-3">
                    <span class="h-2 w-2 bg-green-500 rounded-full animate-pulse shadow-[0_0_10px_rgba(34,197,94,0.6)]"></span>
                    <p class="text-xl font-bold italic tracking-tight">Vault Secured</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 mb-10" data-aos="fade-up">
            <h2 class="text-xs font-black tracking-[0.4em] text-gray-400 uppercase">Available Courses</h2>
            <div class="h-[1px] flex-grow bg-gray-100"></div>
        </div>

        <% if (subjects.length === 0) { %>
            <div class="bg-white border-2 border-dashed border-gray-100 p-24 rounded-[3rem] text-center" data-aos="zoom-in">
                <p class="text-gray-400 font-bold italic text-lg">No curriculum data found for your profile.</p>
            </div>
        <% } else { %>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% subjects.forEach((subject, index) => { %>
                    <div class="subject-card rounded-[2.5rem] p-10 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                        <div>
                            <div class="flex justify-between items-start mb-10">
                                <div class="h-14 w-14 bg-gray-50 rounded-2xl flex items-center justify-center text-3xl shadow-sm">
                                    <%= ['📓', '⚙️', '💻', '📐', '🔬'][index % 5] %>
                                </div>
                                <span class="text-[10px] font-black text-gray-400 border border-gray-100 px-3 py-1.5 rounded-xl uppercase tracking-tighter">
                                    Course 0<%= index + 1 %>
                                </span>
                            </div>

                            <h2 class="text-2xl font-black text-[#1a1a1a] mb-4 leading-tight tracking-tighter">
                                <%= subject.name %>
                            </h2>
                            
                            <p class="text-sm text-gray-500 font-medium mb-8 line-clamp-2 italic">
                                Organized resources including unit-wise notes, textbooks, and previous year papers.
                            </p>

                            <div class="flex gap-4 mb-10">
                                <div class="flex flex-col">
                                    <span class="text-[9px] font-black text-gray-300 uppercase tracking-widest">Syllabus</span>
                                    <span class="text-sm font-bold"><%= subject.units.length %> Units</span>
                                </div>
                                <div class="w-[1px] h-6 bg-gray-100 self-end"></div>
                                <div class="flex flex-col">
                                    <span class="text-[9px] font-black text-gray-300 uppercase tracking-widest">Type</span>
                                    <span class="text-[10px] font-bold text-blue-500 uppercase italic">Core Subject</span>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <a href="/subjects/<%= subject._id %>" 
                               class="block w-full bg-[#0a0a0a] text-white py-4 rounded-2xl text-xs font-black uppercase tracking-widest text-center hover:bg-black transition-all shadow-xl shadow-gray-200 active:scale-95">
                                Enter Subject Vault
                            </a>
                            <a href="/progress/<%= subject._id %>" 
                               class="block w-full border border-gray-100 text-gray-500 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest text-center hover:bg-gray-50 transition-all">
                                Progress Tracker
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <div class="mt-32 grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
            <div class="bg-gray-100/50 rounded-[3rem] p-12">
                <h3 class="text-xs font-black tracking-[0.4em] text-blue-500 uppercase mb-4">Pro Tip</h3>
                <p class="text-2xl font-black italic tracking-tighter mb-6 leading-tight text-[#1a1a1a]">
                    Mastery comes from repetition and solving PYQs.
                </p>
                <p class="text-gray-500 text-sm leading-relaxed mb-8">
                    Don't just read the notes. Watch the curated video lectures and immediately try to solve at least 2 questions from the Previous Year section of that unit.
                </p>
                <div class="flex gap-2">
                    <span class="w-8 h-1 bg-black rounded-full"></span>
                    <span class="w-2 h-1 bg-gray-300 rounded-full"></span>
                    <span class="w-2 h-1 bg-gray-300 rounded-full"></span>
                </div>
            </div>
            
            <div class="p-8">
                <h3 class="text-xs font-black tracking-[0.4em] text-gray-400 uppercase mb-8">Resources Overview</h3>
                <ul class="space-y-6">
                    <li class="flex items-center gap-4">
                        <span class="text-lg">📑</span>
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest">Handwritten Notes</p>
                            <p class="text-[11px] text-gray-400 italic">Curated by top-performing seniors and faculty.</p>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="text-lg">🎥</span>
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest">Video Tutorials</p>
                            <p class="text-[11px] text-gray-400 italic">YouTube links specifically mapped to your syllabus.</p>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="text-lg">📜</span>
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest">Exam Archives</p>
                            <p class="text-[11px] text-gray-400 italic">5+ years of PYQs organized unit-wise.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    <%- include("partials/footer-user") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>
</body>
</html>