<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Directory | RIT AcadeMIA Console</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }
        .notion-card {
            background: white;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }
        .user-table th {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: #9ca3af;
            padding: 1.25rem 1.5rem;
            background: #fcfcfc;
        }
        .user-table td {
            padding: 1.25rem 1.5rem;
            font-size: 13px;
            color: #374151;
            border-bottom: 1px solid #f9fafb;
        }
        .role-badge {
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 4px 10px;
            border-radius: 8px;
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-admin") %>

    <div class="max-w-7xl mx-auto px-6 pt-32 pb-20">

        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6" data-aos="fade-up">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div class="h-2 w-2 rounded-full bg-blue-600 animate-pulse"></div>
                    <h1 class="text-4xl font-black tracking-tighter text-[#1a1a1a] italic">
                        User <span class="text-gray-400 font-light not-italic">Directory</span>
                    </h1>
                </div>
                <p class="text-gray-500 font-medium italic text-sm tracking-tight">Authenticating & Managing Student Access</p>
            </div>
            
            <a href="/admin" 
               class="bg-white border border-gray-200 text-[#1a1a1a] px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-black hover:text-white transition-all shadow-sm active:scale-95">
               ← Back to Console
            </a>
        </div>

        <% if (error.length > 0) { %>
            <div class="bg-red-50 border border-red-100 text-red-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3" data-aos="fade-in">
                <span>⚠️</span> <%= error %>
            </div>
        <% } %>

        <% if (success.length > 0) { %>
            <div class="bg-green-50 border border-green-100 text-green-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3" data-aos="fade-in">
                <span>✅</span> <%= success %>
            </div>
        <% } %>

        <div class="notion-card rounded-[2.5rem] overflow-hidden shadow-sm bg-white" data-aos="fade-up" data-aos-delay="100">
            
            <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between">
                <h2 class="text-[10px] font-black text-gray-400 uppercase tracking-[0.4em]">Database Entries</h2>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest italic">Total Records:</span>
                    <span class="bg-[#0a0a0a] text-white px-3 py-1 rounded-full text-[10px] font-black tracking-tighter"><%= users.length %></span>
                </div>
            </div>

            <% if (users.length === 0) { %>
                <div class="p-24 text-center">
                    <p class="text-gray-400 font-bold italic text-lg">No students or administrators have registered yet.</p>
                </div>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full user-table text-left">
                        <thead>
                            <tr>
                                <th>Identity</th>
                                <th>Email Credentials</th>
                                <th>Branch / Sem</th>
                                <th>Year</th>
                                <th>Access Level</th>
                                <th class="text-center">Control</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <div class="h-9 w-9 bg-gray-100 rounded-xl flex items-center justify-center font-black text-[#1a1a1a] text-xs">
                                                <%= user.name.charAt(0) %>
                                            </div>
                                            <span class="font-bold text-[#1a1a1a]"><%= user.name %></span>
                                        </div>
                                    </td>
                                    
                                    <td class="font-medium text-gray-500 italic">
                                        <%= user.email %>
                                    </td>
                                    
                                    <td>
                                        <div class="flex flex-col gap-1">
                                            <span class="text-[10px] font-black text-blue-600 uppercase tracking-tighter"><%= user.branch %></span>
                                            <span class="text-[9px] font-bold text-gray-400 uppercase">Semester <%= user.semester %></span>
                                        </div>
                                    </td>

                                    <td class="font-bold text-gray-500">
                                        <%= user.year %>
                                    </td>

                                    <td>
                                        <% if(user.role === "admin") { %>
                                            <span class="role-badge bg-purple-50 text-purple-600 border border-purple-100">
                                                Admin Console
                                            </span>
                                        <% } else { %>
                                            <span class="role-badge bg-blue-50 text-blue-600 border border-blue-100">
                                                Student Access
                                            </span>
                                        <% } %>
                                    </td>

                                    <td class="text-center">
                                        <a href="/admin/delete-user/<%= user._id %>" 
                                           class="text-[10px] font-black text-red-400 uppercase tracking-widest hover:text-red-600 transition-colors hover:bg-red-50 px-4 py-2 rounded-xl"
                                           onclick="return confirm('Archive user record permanently?')">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

        <div class="mt-20 flex flex-col md:flex-row justify-between items-center pt-10 border-t border-gray-100 gap-4">
            <p class="text-[9px] font-black text-gray-300 uppercase tracking-[0.5em]">RIT AcadeMIA Terminal Directory</p>
            <div class="flex gap-6">
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest italic">Encrypted Database Link Active</span>
            </div>
        </div>

    </div>

    <%- include("partials/footer-admin") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>
</body>
</html>