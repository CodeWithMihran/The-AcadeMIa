<style>
    /* Premium Hover Underline */
    .admin-nav-link { position: relative; }
    .admin-nav-link::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -6px;
        left: 0;
        background: #3b82f6; /* Admin uses a blue accent */
        transition: width 0.3s ease;
    }
    .admin-nav-link:hover::after { width: 100%; }

    /* Shrink Effect */
    .nav-shrink-admin #nav-container { height: 70px; }

    /* Hamburger Animation */
    .menu-open-admin span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-open-admin span:nth-child(2) { opacity: 0; transform: translateX(10px); }
    .menu-open-admin span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    @keyframes fade-in {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fade-in 0.3s ease-out forwards; }
</style>

<script>
    const navAdmin = document.getElementById('admin-nav');
    const btnAdmin = document.getElementById("menu-btn-admin");
    const menuAdmin = document.getElementById("mobile-menu-admin");
    const iconAdmin = document.getElementById("menu-icon-admin");

    window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
            navAdmin.classList.add('nav-shrink-admin', 'shadow-2xl');
        } else {
            navAdmin.classList.remove('nav-shrink-admin', 'shadow-2xl');
        }
    });

    btnAdmin.addEventListener("click", () => {
        menuAdmin.classList.toggle("hidden");
        iconAdmin.classList.toggle("menu-open-admin");
    });
</script>