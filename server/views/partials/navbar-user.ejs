<style>
    .user-nav-link { position: relative; }
    .user-nav-link::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -6px;
        left: 0;
        background: #fff;
        transition: width 0.3s ease;
    }
    .user-nav-link:hover::after { width: 100%; }
    .nav-shrink-user { background: rgba(10, 10, 10, 0.98); }
    .nav-shrink-user #nav-container { height: 70px; }
    .menu-open-user span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-open-user span:nth-child(2) { opacity: 0; transform: translateX(10px); }
    .menu-open-user span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    @keyframes fade-in { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in { animation: fade-in 0.3s ease-out forwards; }
</style>

<script>
    const navUser = document.getElementById('user-nav');
    const btnUser = document.getElementById("menu-btn-user");
    const menuUser = document.getElementById("mobile-menu-user");
    const iconUser = document.getElementById("menu-icon-user");

    window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
            navUser.classList.add('nav-shrink-user', 'shadow-2xl');
        } else {
            navUser.classList.remove('nav-shrink-user', 'shadow-2xl');
        }
    });

    btnUser.addEventListener("click", () => {
        menuUser.classList.toggle("hidden");
        iconUser.classList.toggle("menu-open-user");
    });
</script>