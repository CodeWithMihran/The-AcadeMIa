<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Subject | RIT AcadeMIA Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }

        .notion-input {
            border: 1px solid #e5e7eb;
            background: white;
            transition: all 0.2s ease;
        }

        .notion-input:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.05);
        }

        .unit-editor-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-left: 4px solid #3b82f6;
            transition: all 0.3s ease;
        }

        .section-label {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: #9ca3af;
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-admin") %>

    <div class="max-w-6xl mx-auto px-6 pt-32 pb-20">

        <div class="mb-12 border-b border-gray-100 pb-10" data-aos="fade-up">
            <div class="flex items-center gap-4 mb-4">
                <a href="/admin" class="text-xs font-bold text-gray-400 hover:text-black transition-colors uppercase tracking-widest">← Back to Console</a>
            </div>
            <h1 class="text-4xl font-black tracking-tighter text-[#1a1a1a] italic">
                Edit <span class="text-blue-600 not-italic">Subject</span>
            </h1>
            <p class="text-gray-500 mt-2 font-medium">Modifying resources for: <span class="text-black font-bold underline underline-offset-4"><%= subject.name %></span></p>
        </div>

        <% if (error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-100 text-red-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3">
                <span>⚠️</span> <%= error %>
            </div>
        <% } %>

        <% if (success && success.length > 0) { %>
            <div class="bg-green-50 border border-green-100 text-green-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3">
                <span>✅</span> <%= success %>
            </div>
        <% } %>

        <form action="/subjects/edit/<%= subject._id %>" method="POST" class="space-y-12" data-aos="fade-up">

            <div class="bg-white border border-gray-200 rounded-[2.5rem] p-8 md:p-10 shadow-sm">
                <h2 class="section-label mb-8">Base Configuration</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Subject Name</label>
                        <input type="text" name="name" value="<%= subject.name %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Branch</label>
                        <input type="text" name="branch" value="<%= subject.branch %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Semester</label>
                        <input type="number" name="semester" value="<%= subject.semester %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <h2 class="section-label">Resource Architecture</h2>
                <div class="h-[1px] flex-grow bg-gray-100"></div>
            </div>

            <div id="unitsContainer" class="space-y-10">
                <% if(subject.units && subject.units.length > 0){ %>
                    <% subject.units.forEach((unit, uIndex) => { %>
                        <div class="unit-editor-card rounded-[2.5rem] p-8 md:p-12 shadow-sm space-y-10 transition-all duration-300">
                            
                            <div class="flex justify-between items-center border-b border-gray-50 pb-6">
                                <h3 class="text-2xl font-black italic tracking-tighter unit-title">Unit 0<%= unit.unitNumber %></h3>
                                <div class="flex items-center gap-4">
                                    <button type="button" onclick="removeUnit(this)" 
                                        class="text-[10px] font-black text-gray-400 uppercase tracking-widest hover:text-red-500 transition-colors py-2 px-4 border border-gray-100 rounded-xl hover:border-red-100 hover:bg-red-50">
                                        ✕ Remove Unit
                                    </button>
                                    <span class="bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">Active Module</span>
                                </div>
                                <input type="hidden" class="unit-number-hidden" name="units[<%= uIndex %>][unitNumber]" value="<%= unit.unitNumber %>">
                            </div>

                            <div class="grid md:grid-cols-2 gap-8">
                                <div class="space-y-2">
                                    <label class="section-label text-gray-600">Module Title</label>
                                    <input name="units[<%= uIndex %>][unitTitle]" value="<%= unit.unitTitle %>"
                                        class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium" placeholder="Unit Title">
                                </div>
                                <div class="space-y-2">
                                    <label class="section-label text-gray-600">Topic Index</label>
                                    <input name="units[<%= uIndex %>][topics]" 
                                        value="<%= unit.topics ? unit.topics.map(t => t.title).join(', ') : '' %>"
                                        class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium" placeholder="Topic 1, Topic 2...">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="p-6 bg-blue-50/30 rounded-3xl border border-blue-100/50 space-y-4">
                                    <p class="section-label text-blue-600">Study Notes</p>
                                    <div class="space-y-2">
                                        <input name="units[<%= uIndex %>][notes][0][title]" value="<%= (unit.notes && unit.notes[0]) ? unit.notes[0].title : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                        <input name="units[<%= uIndex %>][notes][0][link]" value="<%= (unit.notes && unit.notes[0]) ? unit.notes[0].link : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                                    </div>
                                </div>

                                <div class="p-6 bg-purple-50/30 rounded-3xl border border-purple-100/50 space-y-4">
                                    <p class="section-label text-purple-600">Reference Books</p>
                                    <div class="space-y-2">
                                        <input name="units[<%= uIndex %>][books][0][title]" value="<%= (unit.books && unit.books[0]) ? unit.books[0].title : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                        <input name="units[<%= uIndex %>][books][0][link]" value="<%= (unit.books && unit.books[0]) ? unit.books[0].link : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                                    </div>
                                </div>

                                <div class="p-6 bg-red-50/30 rounded-3xl border border-red-100/50 space-y-4">
                                    <p class="section-label text-red-600">University PYQs</p>
                                    <div class="space-y-2">
                                        <input name="units[<%= uIndex %>][pyqs][0][title]" value="<%= (unit.pyqs && unit.pyqs[0]) ? unit.pyqs[0].title : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                        <input name="units[<%= uIndex %>][pyqs][0][link]" value="<%= (unit.pyqs && unit.pyqs[0]) ? unit.pyqs[0].link : '' %>"
                                            class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                                    </div>
                                </div>

                                <div class="p-6 bg-gray-900 rounded-3xl space-y-4">
                                    <p class="section-label text-red-500">Video Tutorials</p>
                                    <div class="space-y-2">
                                        <input name="units[<%= uIndex %>][youtubeLinks][0][title]" value="<%= (unit.youtubeLinks && unit.youtubeLinks[0]) ? unit.youtubeLinks[0].title : '' %>"
                                            class="notion-input !bg-white/5 !border-white/10 !text-white w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                        <input name="units[<%= uIndex %>][youtubeLinks][0][link]" value="<%= (unit.youtubeLinks && unit.youtubeLinks[0]) ? unit.youtubeLinks[0].link : '' %>"
                                            class="notion-input !bg-white/5 !border-white/10 !text-blue-400 w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-10">
                <button type="button" onclick="addUnit()" 
                    class="flex items-center gap-3 bg-white border-2 border-dashed border-gray-200 text-gray-500 px-8 py-4 rounded-2xl font-bold hover:border-blue-500 hover:text-blue-500 transition-all w-full md:w-auto">
                    <span class="text-xl">+</span>
                    <span>Append New Unit</span>
                </button>

                <button class="bg-[#0a0a0a] text-white px-12 py-5 rounded-[2rem] font-black uppercase tracking-[0.3em] text-xs hover:bg-blue-600 transition-all shadow-2xl shadow-gray-300 active:scale-95 w-full md:w-auto">
                    Commit Changes to Vault
                </button>
            </div>

        </form>
    </div>

    <%- include("partials/footer-admin") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        function addUnit() {
            const container = document.getElementById("unitsContainer");
            const currentUnitsCount = document.querySelectorAll(".unit-editor-card").length;
            
            const unitHTML = `
                <div class="unit-editor-card rounded-[2.5rem] p-8 md:p-12 shadow-sm space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <div class="flex justify-between items-center border-b border-gray-50 pb-6">
                        <h3 class="text-2xl font-black italic tracking-tighter unit-title">Unit 0${currentUnitsCount + 1}</h3>
                        <div class="flex items-center gap-4">
                            <button type="button" onclick="removeUnit(this)" 
                                class="text-[10px] font-black text-gray-400 uppercase tracking-widest hover:text-red-500 transition-colors py-2 px-4 border border-gray-100 rounded-xl hover:border-red-100 hover:bg-red-50">
                                ✕ Remove Unit
                            </button>
                            <span class="bg-blue-500 text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">New Module</span>
                        </div>
                        <input type="hidden" class="unit-number-hidden" name="units[${currentUnitsCount}][unitNumber]" value="${currentUnitsCount + 1}">
                    </div>

                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="section-label text-gray-600">Module Title</label>
                            <input name="units[${currentUnitsCount}][unitTitle]" class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium" placeholder="Unit Title">
                        </div>
                        <div class="space-y-2">
                            <label class="section-label text-gray-600">Topic Index</label>
                            <input name="units[${currentUnitsCount}][topics]" class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium" placeholder="Topic 1, Topic 2...">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="p-6 bg-blue-50/30 rounded-3xl border border-blue-100/50 space-y-4">
                            <p class="section-label text-blue-600">Study Notes</p>
                            <div class="space-y-2">
                                <input name="units[${currentUnitsCount}][notes][0][title]" class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                <input name="units[${currentUnitsCount}][notes][0][link]" class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                            </div>
                        </div>

                        <div class="p-6 bg-purple-50/30 rounded-3xl border border-purple-100/50 space-y-4">
                            <p class="section-label text-purple-600">Reference Books</p>
                            <div class="space-y-2">
                                <input name="units[${currentUnitsCount}][books][0][title]" class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                <input name="units[${currentUnitsCount}][books][0][link]" class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                            </div>
                        </div>

                        <div class="p-6 bg-red-50/30 rounded-3xl border border-red-100/50 space-y-4">
                            <p class="section-label text-red-600">University PYQs</p>
                            <div class="space-y-2">
                                <input name="units[${currentUnitsCount}][pyqs][0][title]" class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                <input name="units[${currentUnitsCount}][pyqs][0][link]" class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                            </div>
                        </div>

                        <div class="p-6 bg-gray-900 rounded-3xl space-y-4">
                            <p class="section-label text-red-500">Video Tutorials</p>
                            <div class="space-y-2">
                                <input name="units[${currentUnitsCount}][youtubeLinks][0][title]" class="notion-input !bg-white/5 !border-white/10 !text-white w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                <input name="units[${currentUnitsCount}][youtubeLinks][0][link]" class="notion-input !bg-white/5 !border-white/10 !text-blue-400 w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML("beforeend", unitHTML);
        }

        function removeUnit(button) {
            const card = button.closest(".unit-editor-card");
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
                card.remove();
                renumberUnits();
            }, 300);
        }

        function renumberUnits() {
            const units = document.querySelectorAll(".unit-editor-card");
            units.forEach((unit, index) => {
                const title = unit.querySelector(".unit-title");
                if (title) title.innerText = `Unit 0${index + 1}`;

                const hiddenInput = unit.querySelector(".unit-number-hidden");
                if (hiddenInput) {
                    hiddenInput.name = `units[${index}][unitNumber]`;
                    hiddenInput.value = index + 1;
                }

                const inputs = unit.querySelectorAll("input");
                inputs.forEach(input => {
                    const currentName = input.getAttribute("name");
                    if (currentName) {
                        const newName = currentName.replace(/units\[\d+\]/, `units[${index}]`);
                        input.setAttribute("name", newName);
                    }
                });
            });
        }
    </script>
</body>
</html>