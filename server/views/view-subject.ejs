<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject.name %> | RIT AcadeMIA</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }
        .notion-card {
            background: white;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }
        .sidebar-link {
            transition: all 0.2s ease;
            border-left: 2px solid transparent;
        }
        .sidebar-link:hover {
            background: #f3f4f6;
            border-left-color: #1a1a1a;
        }
        .resource-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        .resource-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.04);
        }
        .sticky-side {
            position: sticky;
            top: 120px;
            height: fit-content;
        }
        /* Modal Animations */
        .modal-animate {
            animation: modalIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.95) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-user") %>

    <div class="max-w-7xl mx-auto px-6 pt-32 pb-20">

        <div class="mb-12 border-b border-gray-100 pb-12" data-aos="fade-up">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="bg-blue-600 text-white text-[10px] font-black px-2 py-1 rounded uppercase tracking-widest">Academic Vault</span>
                        <span class="text-xs font-bold text-gray-400">Semester <%= subject.semester %></span>
                    </div>
                    <h1 class="text-5xl font-black tracking-tighter text-[#1a1a1a] italic leading-none">
                        <%= subject.name %>
                    </h1>
                    <p class="text-gray-500 mt-4 font-medium italic">
                        Vault Directory: <span class="text-black font-bold">RIT / <%= subject.branch %></span>
                    </p>
                </div>
                
                <a href="/progress/<%= subject._id %>" 
                   class="bg-[#0a0a0a] text-white px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-blue-600 transition-all shadow-2xl shadow-gray-200 active:scale-95 flex items-center gap-3">
                   <span>📊</span> Track Mastery
                </a>
            </div>
        </div>

        <div class="grid lg:grid-cols-12 gap-12">
            
            <div class="hidden lg:block lg:col-span-3">
                <div class="sticky-side">
                    <h3 class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-6 px-4">Vault Navigation</h3>
                    <div class="space-y-1">
                        <% if(subject.units && subject.units.length > 0) { %>
                            <% subject.units.forEach((unit) => { %>
                                <a href="#unit-<%= unit.unitNumber %>" class="sidebar-link block px-4 py-3 rounded-xl text-sm font-bold text-gray-600 hover:text-black">
                                    Unit <%= unit.unitNumber %>
                                </a>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-9 space-y-20">
                
                <% if(subject.units && subject.units.length > 0) { %>
                    <% subject.units.forEach((unit) => { %>
                        <section id="unit-<%= unit.unitNumber %>" class="scroll-mt-32" data-aos="fade-up">
                            <div class="flex items-center gap-4 mb-8">
                                <span class="h-10 w-10 bg-black text-white rounded-xl flex items-center justify-center font-black italic text-lg shadow-lg">
                                    <%= unit.unitNumber %>
                                </span>
                                <h2 class="text-3xl font-black tracking-tighter text-[#1a1a1a]">
                                    <%= unit.unitTitle %>
                                </h2>
                            </div>

                            <div class="flex flex-wrap gap-2 mb-10">
                                <% if(unit.topics && unit.topics.length > 0) { %>
                                    <% unit.topics.forEach(topic => { %>
                                        <span class="bg-gray-100 text-gray-600 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-tight">
                                            <%= topic.title %>
                                        </span>
                                    <% }) %>
                                <% } %>
                            </div>

                            <div class="grid md:grid-cols-2 gap-6">
                                
                                <div class="space-y-6">
                                    <div>
                                        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-4">Reading Materials</p>
                                        <div class="space-y-3">
                                            <% if(unit.notes && unit.notes.length > 0) { %>
                                                <% unit.notes.forEach(note => { %>
                                                    <div onclick="openPdfModal('<%= note.link %>', '<%= note.title %>')" class="resource-btn notion-card p-4 rounded-2xl flex items-center justify-between group">
                                                        <div class="flex items-center gap-3">
                                                            <span class="text-xl">📄</span>
                                                            <span class="text-sm font-bold text-gray-700 group-hover:text-black"><%= note.title %></span>
                                                        </div>
                                                        <span class="text-[9px] font-black text-blue-500 uppercase tracking-tighter">View PDF</span>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                            <% if(unit.books && unit.books.length > 0) { %>
                                                <% unit.books.forEach(book => { %>
                                                    <div onclick="openPdfModal('<%= book.link %>', '<%= book.title %>')" class="resource-btn notion-card p-4 rounded-2xl flex items-center justify-between group">
                                                        <div class="flex items-center gap-3">
                                                            <span class="text-xl">📖</span>
                                                            <span class="text-sm font-bold text-gray-700 group-hover:text-black"><%= book.title %></span>
                                                        </div>
                                                        <span class="text-[9px] font-black text-purple-500 uppercase tracking-tighter">Open Book</span>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div>
                                        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-4">Exam Prep</p>
                                        <div class="space-y-3">
                                            <% if(unit.pyqs && unit.pyqs.length > 0) { %>
                                                <% unit.pyqs.forEach(pyq => { %>
                                                    <div onclick="openPdfModal('<%= pyq.link %>', '<%= pyq.title %>')" class="resource-btn notion-card p-4 rounded-2xl flex items-center justify-between group">
                                                        <div class="flex items-center gap-3">
                                                            <span class="text-xl">🎯</span>
                                                            <span class="text-sm font-bold text-gray-700 group-hover:text-black"><%= pyq.title %></span>
                                                        </div>
                                                        <span class="text-[9px] font-black text-green-500 uppercase tracking-tighter">Solve PYQ</span>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-4">Video Archive</p>
                                    <div class="space-y-3">
                                        <% if(unit.youtubeLinks && unit.youtubeLinks.length > 0) { %>
                                            <% unit.youtubeLinks.forEach(video => { %>
                                                <button onclick="openVideoModal('<%= video.link %>', '<%= video.title %>')"
                                                    class="resource-btn w-full notion-card p-5 rounded-2xl flex items-center justify-between group bg-gray-900 border-none shadow-xl">
                                                    <div class="flex items-center gap-4 text-left">
                                                        <div class="h-10 w-10 rounded-full bg-red-500/10 flex items-center justify-center text-red-500 group-hover:bg-red-500 group-hover:text-white transition-all">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                                                            </svg>
                                                        </div>
                                                        <span class="text-sm font-bold text-gray-200 uppercase tracking-widest leading-tight"><%= video.title %></span>
                                                    </div>
                                                    <span class="hidden sm:block text-[9px] font-black text-gray-500 uppercase tracking-widest">Stream</span>
                                                </button>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="notion-card p-12 rounded-[2rem] text-center border-dashed">
                                                <p class="text-xs text-gray-400 italic">No video lectures synchronized.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                            </div>
                        </section>
                        <div class="h-[1px] w-full bg-gray-100"></div>
                    <% }) %>
                <% } else { %>
                    <div class="notion-card p-24 rounded-[3rem] text-center" data-aos="zoom-in">
                        <p class="text-gray-400 font-bold italic text-lg">No curriculum data discovered in this vault yet.</p>
                    </div>
                <% } %>

            </div>
        </div>
    </div>

    <div id="videoModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 md:p-10">
        <div class="absolute inset-0 bg-black/90 backdrop-blur-md transition-opacity" onclick="closeVideoModal()"></div>
        <div class="relative w-full max-w-5xl aspect-video bg-black rounded-[2rem] overflow-hidden shadow-2xl border border-white/10 modal-animate">
            <div class="absolute top-0 left-0 right-0 p-6 flex justify-between items-center z-10 bg-gradient-to-b from-black/80 to-transparent">
                <h3 id="modalVideoTitle" class="text-white font-black italic tracking-tighter text-xl truncate pr-10"></h3>
                <button onclick="closeVideoModal()" class="bg-white/10 hover:bg-red-500 text-white p-3 rounded-full transition-all active:scale-90">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <iframe id="videoFrame" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>

    <div id="pdfModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-2 md:p-6">
        <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closePdfModal()"></div>
        <div class="relative w-full max-w-6xl h-[92vh] bg-white rounded-[1.5rem] overflow-hidden shadow-2xl flex flex-col modal-animate">
            <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-white">
                <div class="px-4">
                    <h3 id="modalPdfTitle" class="font-black text-gray-800 truncate text-lg"></h3>
                    <p class="text-[10px] text-blue-600 font-bold uppercase tracking-widest">RIT AcadeMIA Document Vault</p>
                </div>
                <div class="flex items-center gap-2">
                    <a id="pdfDownloadBtn" href="#" target="_blank" class="p-3 hover:bg-gray-100 rounded-xl transition-all flex items-center gap-2 text-xs font-bold text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12 a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span class="hidden md:block">Download</span>
                    </a>
                    <button onclick="closePdfModal()" class="p-3 hover:bg-red-50 text-gray-400 hover:text-red-500 rounded-xl transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="flex-grow bg-gray-100 relative">
                <iframe id="pdfFrame" class="w-full h-full" src="" frameborder="0"></iframe>
                <div id="pdfSpinner" class="absolute inset-0 flex items-center justify-center bg-gray-50 z-0">
                    <div class="flex flex-col items-center gap-4">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                        <p class="text-[10px] font-black uppercase text-gray-400 tracking-widest">Decrypting Vault File...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include("partials/footer-user") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });

        // --- VIDEO PLAYER LOGIC ---
        function openVideoModal(url, title) {
            const modal = document.getElementById('videoModal');
            const frame = document.getElementById('videoFrame');
            const titleEl = document.getElementById('modalVideoTitle');

            let videoId = "";
            try {
                if (url.includes('youtu.be/')) {
                    videoId = url.split('youtu.be/')[1].split(/[?&]/)[0];
                } else if (url.includes('watch?v=')) {
                    videoId = url.split('v=')[1].split(/[?&]/)[0];
                } else if (url.includes('embed/')) {
                    videoId = url.split('embed/')[1].split(/[?&]/)[0];
                }
            } catch (e) { console.error("Link parsing failed", e); }

            if (videoId) {
                frame.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;
                titleEl.innerText = title;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                window.open(url, '_blank');
            }
        }

        function closeVideoModal() {
            document.getElementById('videoModal').classList.add('hidden');
            document.getElementById('videoFrame').src = "";
            document.body.style.overflow = 'auto';
        }

        // --- PDF READER LOGIC ---
        function openPdfModal(url, title) {
            const modal = document.getElementById('pdfModal');
            const frame = document.getElementById('pdfFrame');
            const titleEl = document.getElementById('modalPdfTitle');
            const downloadBtn = document.getElementById('pdfDownloadBtn');
            const spinner = document.getElementById('pdfSpinner');

            spinner.style.display = 'flex';
            titleEl.innerText = title;
            downloadBtn.href = url;

            // Handle Google Drive links specifically for preview mode
            if (url.includes('drive.google.com')) {
                let fileId = "";
                if (url.includes('/d/')) {
                    fileId = url.split('/d/')[1].split('/')[0];
                } else if (url.includes('id=')) {
                    fileId = url.split('id=')[1].split('&')[0];
                }
                frame.src = `https://drive.google.com/file/d/${fileId}/preview`;
            } else {
                // Direct PDF link with toolbar enabled
                frame.src = url + "#toolbar=1";
            }

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';

            frame.onload = function() {
                spinner.style.display = 'none';
            };
        }

        function closePdfModal() {
            document.getElementById('pdfModal').classList.add('hidden');
            document.getElementById('pdfFrame').src = "";
            document.body.style.overflow = 'auto';
        }

        // Global Close Trigger (Escape Key)
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeVideoModal();
                closePdfModal();
            }
        });
    </script>
</body>
</html>