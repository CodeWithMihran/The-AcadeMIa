# Copy to server/.env for local development. Never commit populated .env files.
MONGODB_URI=mongodb://127.0.0.1:27017/theacademia
JWT_KEY=replace-with-a-long-random-secret
EXPRESS_SESSION_SECRET=replace-with-another-long-random-secret
CLIENT_URL=http://127.0.0.1:5173
PORT=3000

# Optional Google web OAuth. Set all three values to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional local override; on Render this is /var/data/notes on a persistent disk.
# STORAGE_DIR=
